{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vv-zero-oss.github.io/codecaine-marketplace/schemas/marketplace-catalog.schema.json",
  "title": "json/<kind>.json",
  "description": "Every item of one kind: its marketplace.json plus what the build computed. Generated by scripts/build.mjs.",
  "type": "object",
  "required": ["registryVersion", "type", "items"],
  "properties": {
    "registryVersion": { "const": 1 },
    "type": { "enum": ["template", "app", "design-system", "skill"] },
    "items": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "marketplace-item.schema.json" },
          {
            "type": "object",
            "required": ["path", "archive", "source"],
            "properties": {
              "path": { "type": "string" },
              "thumbnailUrl": { "type": "string" },
              "entryUrl": { "type": "string" },
              "archive": {
                "type": "object",
                "required": ["url", "format", "sha256", "size"],
                "properties": {
                  "url": { "type": "string" },
                  "format": { "const": "tar+gzip" },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Of the uncompressed tar." },
                  "size": { "type": "integer", "description": "Bytes of the uncompressed tar." },
                  "files": { "type": "integer" }
                }
              },
              "source": {
                "type": "object",
                "properties": { "repository": { "type": "string" }, "ref": { "type": "string" }, "path": { "type": "string" } }
              },
              "designSystem": {
                "type": "object",
                "properties": {
                  "palette": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "value": { "type": "string" } } } },
                  "fonts": { "type": "array", "items": { "type": "string" } },
                  "dark": { "type": "boolean" }
                }
              },
              "app": { "type": "object" },
              "skill": { "type": "object" }
            }
          }
        ]
      }
    }
  }
}

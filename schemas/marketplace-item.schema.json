{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vv-zero-oss.github.io/codecaine-marketplace/schemas/marketplace-item.schema.json",
  "title": "marketplace.json",
  "description": "What a marketplace item says about itself. One per item folder.",
  "type": "object",
  "required": [
    "type",
    "id",
    "name",
    "version",
    "description",
    "authors",
    "license",
    "keywords",
    "categories",
    "created",
    "updated"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "enum": [
        "template",
        "app",
        "design-system",
        "skill"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Kebab-case; equals the folder name."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sdkVersion": {
      "type": "string",
      "description": "The @canvas/react version a template vendors or an app targets."
    },
    "canvasVersion": {
      "type": "string",
      "description": "The editor versions this works with, as a semver range: \">=0.0.1\"."
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    "license": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "thumbnail": {
      "type": "string",
      "description": "A picture of the item, relative to its folder."
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry": {
      "type": "string",
      "description": "The file that is the item: canvas-app.json, DESIGN.md, SKILL.md."
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "pages": {
      "type": "array",
      "description": "Templates: the routes the project serves, for the editor's page list.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "title"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "description": "Anything else. Templates: framework, installCommand, devCommand, port. Apps: appId, permissions.",
      "properties": {
        "framework": {
          "type": "string"
        },
        "installCommand": {
          "type": "string"
        },
        "devCommand": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "appId": {
          "type": "string"
        }
      }
    },
    "designedFor": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Who and what the item is for \u2014 the bullets on its page in the editor."
    },
    "icon": {
      "type": "string",
      "description": "A square icon, relative to the item's folder."
    },
    "previews": {
      "type": "object",
      "description": "Templates: what the item's page shows. Written by scripts/capture-previews.mjs.",
      "properties": {
        "desktop": {
          "type": "string"
        },
        "mobile": {
          "type": "string"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "image"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "image": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}

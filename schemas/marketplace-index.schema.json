{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vv-zero-oss.github.io/codecaine-marketplace/schemas/marketplace-index.schema.json",
  "title": "json/index.json",
  "description": "The one URL the editor knows. Generated by scripts/build.mjs.",
  "type": "object",
  "required": ["registryVersion", "name", "root", "catalogs"],
  "properties": {
    "registryVersion": { "const": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "root": { "type": "string", "description": "What every catalog and item URL is relative to, itself relative to this file." },
    "site": { "type": "string" },
    "repository": { "type": "string" },
    "updated": { "type": ["string", "null"] },
    "catalogs": {
      "type": "object",
      "propertyNames": { "enum": ["template", "app", "design-system", "skill"] },
      "additionalProperties": {
        "type": "object",
        "required": ["url", "count"],
        "properties": { "url": { "type": "string" }, "count": { "type": "integer" } }
      }
    }
  }
}

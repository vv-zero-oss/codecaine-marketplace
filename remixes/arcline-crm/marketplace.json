  "id": "arcline-crm",
  "name": "Arcline — AI CRM",
  "version": "2.0.0",
  "description": "A minimal, dark five-page site for Arcline, an AI CRM: a hero app window that answers a question live, a sticky five-chapter platform tour with HTML product mockups (table and email composer, workflow builder, pipeline board, analyst, charts), a Deal Memory band with isometric line icons, pricing with a comparison table, customers, an agents page and a changelog.",
  "designedFor": [
    "AI and SaaS products that want a calm, precise, hairline-grid landing page",
    "CRM, sales and revenue tools that need to show their product, not describe it",
    "Seeing HTML product mockups, micro-interactions and agent-UI primitives the editor can drive"
  ],
  "sdkVersion": "0.1.1",
  "canvasVersion": ">=0.0.1",

{
  "$schema": "../../schemas/marketplace-item.schema.json",
  "type": "remix",
  "id": "codecaine-homepage",
  "name": "Codecaine Homepage",
  "version": "1.0.0",
  "description": "The Codecaine homepage and features page, built on a token-driven design system: every colour, shadow, radius, duration and easing is a named token, light and dark, with 61 shadcn/ui components bridged onto the same tokens.",
  "designedFor": [
    "Launching a product homepage with a sticky mega-menu nav, feature cards and a marquee gallery",
    "Teams who want one token layer that drives their marketing pages and their shadcn/ui components alike",
    "Showing an AI agent's workflow beside the work it does, card by card as the page scrolls",
    "Starting a design system with brand guidelines rendered from the live tokens, in light and dark"
  ],
  "sdkVersion": "0.1.1",
  "canvasVersion": ">=0.0.1",
  "authors": [
    {
      "name": "Codecaine",
      "url": "https://github.com/vv-zero-oss"
    }
  ],
  "license": "MIT",

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@canvas/react/hook": ["./src/lib/canvas-react/install-hook.ts"],
      "@canvas/react": ["./src/lib/canvas-react/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

  "name": "Aurel",
  "version": "1.1.0",
  "description": "A high-end fashion house's site in bone, ink and burnt orange: a film that folds into the header, a garment rising through its headline, sticky split columns, a drifting archive wall and a turning silver seal — across home, collection, product, atelier, journal, house and appointments.",
  "designedFor": [
    "Fashion houses, boutiques and ateliers selling a small, considered collection",
    "Editorial landing pages built on sticky, scroll-linked sections",
    "A multi-page shop — collection, product, bag — with every hidden state reachable from the editor",
    "Studying scroll choreography: pinned stages, clip-path reveals, stacking cards and a sideways track"
  ],
  "sdkVersion": "0.1.1",
  "canvasVersion": ">=0.0.1",

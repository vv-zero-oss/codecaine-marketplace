{
  "$schema": "../../schemas/marketplace-item.schema.json",
  "type": "remix",
  "id": "riot-folio",
  "name": "Riot Folio",
  "version": "1.0.0",
  "description": "A loud portfolio for an independent builder — electric ultramarine, six saturated project tones, duotone photography, hero cards that fly into the work grid on scroll, odometer stats and a filterable project archive.",
  "designedFor": [
    "Designers, engineers and consultants who want a portfolio people remember",
    "Showing a handful of case studies properly and the rest as a searchable archive",
    "A bold, colourful starting point that is still quiet enough to read",
    "Trying scroll-linked motion that the editor can name, tune and pause"
  ],
  "sdkVersion": "0.1.1",
  "canvasVersion": ">=0.0.1",
  "authors": [
    {
      "name": "Codecaine",
      "url": "https://github.com/vv-zero-oss"
    }
  ],
  "license": "MIT",
  "keywords": [
    "portfolio",
    "personal",
    "case-study",
    "colourful",
    "bold",
    "duotone",
    "motion",
    "framer-motion",
    "lenis"
  ],
  "categories": [
    "Portfolio",
    "Personal"
  ],
  "created": "2026-09-30",
  "updated": "2026-09-30",
  "thumbnail": "preview.png",
  "meta": {
    "framework": "vite",
    "language": "typescript",
    "styling": "tailwindcss@4",
    "installCommand": "npm install",
    "devCommand": "npm run dev",
    "port": 3300
  },

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@canvas/react": ["./src/lib/canvas-react/index.ts"],
      "@canvas/react/hook": ["./src/lib/canvas-react/install-hook.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

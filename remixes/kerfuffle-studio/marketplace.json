  "id": "kerfuffle-studio",
  "name": "Kerfuffle Studio",
  "version": "1.2.0",
  "description": "A restrained, editorial site for a motion studio: paper and ink with a single accent, one typeface (Instrument Sans) plus a mono for labels, a twelve-column grid with numbered section labels and hairlines. Finished work drops under the cursor in the hero, an ink brush stroke sweeps the screen on every page change, recent projects pile up in a pinned reel, services show a spring-following preview on hover, and the team, a filterable project archive with case studies, a brief form and a full style guide complete it.",
  "designedFor": [
    "Animation, film and social-content studios that want the work to do the talking",
    "Editorial portfolio sites built on a strict grid, with motion used sparingly",
    "Multi-page studio sites: home, about, work with case studies, services and contact",
    "Seeing Motion, Lenis and CSS animation on one page the canvas editor can pause, reduce and edit"
  ],
  "sdkVersion": "0.1.1",
  "canvasVersion": ">=0.0.1",
  "authors": [
    {
      "name": "Tamsin Achterberg"
    }
  ],
  "license": "MIT",

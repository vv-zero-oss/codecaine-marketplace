{
  "$schema": "../../schemas/marketplace-item.schema.json",
  "type": "remix",
  "id": "kerfuffle-studio",
  "name": "Kerfuffle Studio",
  "version": "1.0.0",
  "description": "A loud, playful site for a motion studio: heavy condensed caps answered by a light serif, photos that drop under the cursor in the hero, a blue brush stroke that sweeps across the screen on every page change, a pinned reel of case cards that pile up as you scroll, service cards that fan out, die-cut stickers you can slap onto the page, a scattered crew with bubble-lettered names, a filterable work grid with case studies, a brief form and a full style guide.",
  "designedFor": [
    "Animation, video and social-content studios, and creative agencies with a lot of personality",
    "Portfolios that want motion to be the first thing a visitor notices — page transitions, cursor trails, scroll-pinned reels",
    "Multi-page sites: home, about, work with case studies, services and contact",
    "Seeing Motion, Lenis and CSS animation on one page the canvas editor can pause, reduce and edit"
  ],
  "sdkVersion": "0.1.1",
  "canvasVersion": ">=0.0.1",
  "authors": [
    {
      "name": "Tamsin Achterberg"
    }
  ],
  "license": "MIT",
